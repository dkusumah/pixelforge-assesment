# Supervisor configuration template for Pixelforge Background Queue Workers
# Save as: /etc/supervisor/conf.d/pixelforge-worker.conf

[program:pixelforge-worker]
process_name=%(program_name)s_%(process_num)02d
command=php /var/www/pixelforge/artisan queue:work --sleep=3 --tries=3 --max-time=3600
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user=www-data
numprocs=2
redirect_stderr=true
stdout_logfile=/var/www/pixelforge/storage/logs/worker.log
stopwaitsecs=3600
